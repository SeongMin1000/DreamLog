<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white_black_background">

            <!-- 툴바 -->
            <include layout="@layout/toolbar" />

            <!-- 결과 상단 타이틀 -->
            <TextView
                android:id="@+id/textResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="결과"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black_white_text"
                android:gravity="center"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textResultSubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="하루의 시작, 내면을 돌아보는 시간"
                android:textSize="15sp"
                android:textColor="@color/gray_gray_hint_text"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <!-- 카드 (ConstraintLayout 중앙, 비율 고정, 가로폭은 반응형) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- 카드: 화면의 70% 높이 & 가로폭 최대 500dp로 중앙 -->
                <LinearLayout
                    android:id="@+id/resultCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_input_rounded"
                    android:clipToOutline="true"
                    android:elevation="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="28dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.90"
                    app:layout_constraintWidth_max="360dp">

                    <!-- 생성된 이미지: 카드 높이의 40% (정사각형 비율) -->
                    <FrameLayout
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:background="#F6F8FB"
                        android:layout_gravity="center"
                        android:clipToOutline="true"
                        android:elevation="4dp"
                        android:outlineProvider="background"
                        android:layout_marginBottom="32dp">

                        <ImageView
                            android:id="@+id/generatedImageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:contentDescription="생성된 이미지"
                            android:clipToOutline="true"/>
                    </FrameLayout>

                    <!-- 감정 분석 결과 -->
                    <TextView
                        android:id="@+id/textEmotionResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="감정 분석 중..."
                        android:textColor="#4F46E5"
                        android:textSize="16sp" />

                    <!-- GPT 해석 결과 (남은 공간 비율 크게) -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:overScrollMode="ifContentScrolls"
                        android:background="@android:color/transparent"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/textGptResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="꿈 해석 중..."
                            android:textColor="#333A5D"
                            android:textSize="15sp"
                            android:lineSpacingExtra="2dp"
                            android:hyphenationFrequency="full"
                            tools:text="이곳에 해석 결과가 표시됩니다. 아주 긴 텍스트도 자연스럽게 자동 줄바꿈되고, 길면 스크롤이 가능합니다." />
                    </ScrollView>

                    <!-- 버튼 영역 (하단 고정) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="2dp">

                        <!-- 저장 버튼 -->
                        <Button
                            android:id="@+id/btnSave"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="저장"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:background="@drawable/bg_btn_primary"
                            android:textColor="@color/white_black_button_text"
                            android:layout_marginEnd="10dp"
                            android:clipToOutline="true"
                            android:elevation="2dp"
                            style="@android:style/Widget.Button" />

                        <!-- 캘린더 등록 버튼 -->
                        <Button
                            android:id="@+id/btnAddToCalendar"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="캘린더에 등록"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:background="@drawable/bg_btn_outline"
                            android:textColor="@color/purple_purple_accent_text"
                            android:clipToOutline="true"
                            android:elevation="0dp"
                            style="@android:style/Widget.Button" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- 네비게이션 드로어 -->
        <include layout="@layout/drawer_layout" />

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>
