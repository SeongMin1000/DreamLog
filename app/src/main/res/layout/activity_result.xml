<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/white_black_background">

                <include layout="@layout/toolbar" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbarThumbVertical="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textResultTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="결과"
                            android:textSize="24sp"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textColor="@color/black_white_text"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="12dp"
                            android:layout_marginHorizontal="20dp" />

                        <TextView
                            android:id="@+id/textResultSubTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="하루의 시작, 내면을 돌아보는 시간"
                            android:textSize="15sp"
                            android:textColor="@color/gray_gray_hint_text"
                            android:gravity="center"
                            android:layout_marginBottom="28dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginHorizontal="20dp"
                            android:lineSpacingExtra="4dp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="280dp"
                            android:layout_height="280dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp">

                            <ImageView
                                android:id="@+id/generatedImageView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:background="#F6F8FB"
                                android:contentDescription="생성된 이미지" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/textEmotionResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginBottom="5dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:text="감정 분석 중..."
                            android:textColor="#4F46E5"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.01" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E7EB"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginBottom="15dp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="185dp"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginBottom="25dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="@color/white_black_input_bg">

                            <ScrollView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:overScrollMode="ifContentScrolls"
                                android:background="@android:color/transparent"
                                android:fillViewport="true"
                                android:scrollbarThumbVertical="@android:color/transparent"
                                android:fadeScrollbars="true">

                                <TextView
                                    android:id="@+id/textGptResult"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif"
                                    android:gravity="start"
                                    android:padding="20dp"
                                    android:text="꿈 해석 중..."
                                    android:textColor="@color/black_white_input_text"
                                    android:textSize="16sp"
                                    android:lineSpacingExtra="8dp"
                                    android:hyphenationFrequency="full"
                                    tools:text="이곳에 해석 결과가 표시됩니다. 아주 긴 텍스트도 자연스럽게 자동 줄바꿈되고, 길면 스크롤이 가능합니다." />
                            </ScrollView>
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="20dp"
                            android:paddingBottom="32dp">

                            <Button
                                android:id="@+id/btnSave"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:text="저장"
                                android:textAllCaps="false"
                                android:textSize="16sp"
                                android:background="@drawable/bg_btn_primary"
                                android:textColor="@color/white_black_button_text" />

                            <Button
                                android:id="@+id/btnAddToCalendar"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="캘린더에 등록"
                                android:textAllCaps="false"
                                android:textSize="16sp"
                                android:background="@drawable/bg_btn_outline"
                                android:textColor="@color/purple_purple_accent_text" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </FrameLayout>

        <include layout="@layout/drawer_layout" />
    </androidx.drawerlayout.widget.DrawerLayout>
</layout>
