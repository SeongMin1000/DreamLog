<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 메인 컨텐츠 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/white_black_background">

                <include layout="@layout/toolbar"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbarThumbVertical="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 타이틀 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="오늘의 꿈 기록"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/black_white_text"
                            android:gravity="center"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="12dp"
                            android:layout_marginHorizontal="20dp"
                            android:accessibilityHeading="true" />

                        <!-- 안내문구 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="떠오르는 꿈을 간단히 입력하고 셀카로 감정도 남겨보세요."
                            android:textSize="15sp"
                            android:textColor="@color/gray_gray_hint_text"
                            android:gravity="center"
                            android:layout_marginBottom="28dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginHorizontal="20dp"
                            android:lineSpacingExtra="4dp"
                            android:importantForAccessibility="yes"/>

                        <!-- 셀카 미리보기 -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="280dp"
                            android:layout_height="280dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="#F6F8FB">

                            <ImageView
                                android:id="@+id/imagePreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:background="@android:color/transparent"
                                android:contentDescription="사진 미리보기"
                                android:clickable="true"
                                android:focusable="true"/>
                        </androidx.cardview.widget.CardView>

                        <!-- 입력창 -->
                        <EditText
                            android:id="@+id/editDream"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:hint="꿈을 입력하세요..."
                            android:textColorHint="@color/gray_gray_hint_text"
                            android:textColor="@color/black_white_input_text"
                            android:gravity="top|start"
                            android:padding="14dp"
                            android:textSize="16sp"
                            android:background="@drawable/bg_input_rounded"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="30dp"
                            android:layout_marginBottom="25dp"
                            android:outlineProvider="background"
                            android:clipToOutline="true"
                            android:inputType="textMultiLine"
                            android:maxLines="12"
                            android:backgroundTintMode="src_in"
                            android:contentDescription="꿈 입력창"
                            style="@android:style/Widget.EditText" />

                        <!-- 결과 보기 버튼 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="20dp"
                            android:paddingBottom="32dp">

                            <Button
                                android:id="@+id/btnNext"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:text="결과 보기"
                                android:textAllCaps="false"
                                android:textSize="16sp"
                                android:background="@drawable/bg_btn_primary"
                                android:textColor="@color/white_black_button_text"
                                android:elevation="2dp"
                                android:clipToOutline="true"
                                android:stateListAnimator="@null"
                                android:padding="0dp"
                                android:contentDescription="결과 보기 버튼"
                                style="@android:style/Widget.Button" />
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- 터치 차단용 투명 뷰 -->
            <View
                android:id="@+id/blockTouchView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#00000000"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

            <!-- 중앙 ProgressBar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:visibility="gone"/>
        </FrameLayout>

        <include layout="@layout/drawer_layout" />

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>